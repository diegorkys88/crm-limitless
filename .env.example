# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./crm.db
# For production switch to:
# DATABASE_URL=postgresql://user:password@host:5432/crm_db

# ── Claude AI ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Kajabi ─────────────────────────────────────────────────────────────────────
KAJABI_API_KEY=your_kajabi_api_key_here
KAJABI_BASE_URL=https://kajabi.com/api/v1

# ── ClickFunnels ───────────────────────────────────────────────────────────────
CLICKFUNNELS_API_KEY=your_clickfunnels_api_key_here
CLICKFUNNELS_WORKSPACE_ID=your_workspace_id

# ── Apollo.io ──────────────────────────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Calendly ───────────────────────────────────────────────────────────────────
CALENDLY_API_KEY=your_calendly_api_key_here
CALENDLY_WEBHOOK_SECRET=your_webhook_secret_here
CALENDLY_BASE_URL=https://calendly.com

# ── Email ──────────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=crm@yourcompany.com
EMAIL_FROM_NAME=Your Company
